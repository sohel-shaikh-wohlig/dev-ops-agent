# ==================== API Settings ====================
API_TITLE=DevOps Automation API
API_VERSION=1.0.0
API_DESCRIPTION=FastAPI wrapper for DevOps Automation
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
ALLOWED_ORIGINS=*

# File Upload
UPLOAD_DIR=/tmp/uploads
MAX_FILE_SIZE=20971520

# ==================== ArgoCD Server Configuration ====================
# Default (used when env is None or 'default')
ARGOCD_SERVER=https://argocd-dev.example.com
ARGOCD_USERNAME=admin
ARGOCD_PASSWORD=your-password
ARGOCD_TOKEN=your-token

# DEV Environment
ARGOCD_SERVER_DEV=https://argocd-dev.example.com
ARGOCD_TOKEN_DEV=your-dev-token
ARGOCD_USERNAME_DEV=admin
ARGOCD_PASSWORD_DEV=your-dev-password

# TEST Environment
ARGOCD_SERVER_TEST=https://argocd-dev.example.com
ARGOCD_TOKEN_TEST=your-test-token
ARGOCD_USERNAME_TEST=admin
ARGOCD_PASSWORD_TEST=your-test-password

# UAT Environment
ARGOCD_SERVER_UAT=https://argocd-uat.example.com
ARGOCD_TOKEN_UAT=your-uat-token
ARGOCD_USERNAME_UAT=admin
ARGOCD_PASSWORD_UAT=your-uat-password

# STAGING Environment
ARGOCD_SERVER_STAGING=https://argocd-staging.example.com
ARGOCD_TOKEN_STAGING=your-staging-token
ARGOCD_USERNAME_STAGING=admin
ARGOCD_PASSWORD_STAGING=your-staging-password

# PROD Environment
ARGOCD_SERVER_PROD=https://argocd.example.com
ARGOCD_TOKEN_PROD=your-prod-token
ARGOCD_USERNAME_PROD=admin
ARGOCD_PASSWORD_PROD=your-prod-password

# SSL Configuration
VERIFY_SSL=True

# Default Settings
DEFAULT_PROJECT=default
DEFAULT_SERVER=https://kubernetes.default.svc
DEFAULT_NAMESPACE=default
DEFAULT_SYNC_TIMEOUT=300
AUTO_SYNC=False
AUTO_PRUNE=False
SELF_HEAL=False
AUTO_RENEW_TOKEN=true

# ==================== GitHub Configuration ====================
GIT_USER_NAME=DevOps Automation
GIT_USER_EMAIL=devops@automation.local
GITHUB_TOKEN=your-github-token
GH_TOKEN=your-github-token

# GitOps Repository
GITOPS_REPO_URL=git@github.com:org/gitops.git
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ==================== Preview Session Configuration ====================
PREVIEW_SESSION_TTL_MINUTES=60

# ==================== Cloudflare Configuration ====================
CLOUDFLARE_TOKEN=your-cloudflare-token
CLOUDFLARE_ZONE_ID=your-zone-id

# ==================== Load Balancer IPs (Environment-Specific) ====================
# Default (used when env is None or 'default')
LOAD_BALANCER_IP=34.180.18.42

# DEV Environment
LOAD_BALANCER_IP_DEV=34.107.98.232

# TEST Environment
LOAD_BALANCER_IP_TEST=34.107.98.232

# UAT Environment
LOAD_BALANCER_IP_UAT=34.107.98.232

# STAGING Environment
LOAD_BALANCER_IP_STAGING=34.180.39.91

# PROD Environment
LOAD_BALANCER_IP_PROD=34.180.39.91

# ==================== Redis Configuration ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5

# ==================== Atlantis Configuration (optional) ====================
# ATLANTIS_GH_USER=your-github-user
# ATLANTIS_GH_TOKEN=your-github-token
# ATLANTIS_GH_WEBHOOK_SECRET=your-webhook-secret
# ATLANTIS_REPO_ALLOWLIST=github.com/org/terraform-devops