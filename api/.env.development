API_TITLE=DevOps Automation API
API_VERSION=1.0.0
API_DESCRIPTION=FastAPI wrapper for DevOps Automation
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
ALLOWED_ORIGINS=*

# ==================== ArgoCD Server Configuration ====================
ARGOCD_SERVER=https://argocd.example.com/
ARGOCD_TOKEN=your-argocd-token-here
ARGOCD_USERNAME=admin
ARGOCD_PASSWORD=your-password-here
VERIFY_SSL=True
DEFAULT_PROJECT=default
DEFAULT_SERVER=https://kubernetes.default.svc
DEFAULT_NAMESPACE=default
DEFAULT_SYNC_TIMEOUT=300
AUTO_SYNC=False
AUTO_PRUNE=False
SELF_HEAL=False
AUTO_RENEW_TOKEN=True